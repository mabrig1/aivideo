{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aivideo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "VIDEO_ASSETS",
      "bucket_name": "mabrig-verse"
    }
  ],
  "routes": [
    {
      "pattern": "aivideo.mabrigkorie.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://aivideo.mabrigkorie.org"
  },
  "observability": {
    "enabled": true
  }
}
