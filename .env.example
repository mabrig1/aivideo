# Public app URL
NEXT_PUBLIC_APP_URL=https://aivideo.mabrigkorie.org

# Reasoning / agent providers
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Universal video router
# Google Vids included quota is an account entitlement, not Gemini/Veo API credit.
# Keep disabled until an authorized connector/local bridge supplies the user's quota.
GOOGLE_VIDS_BRIDGE_ENABLED=false

# Gemini/Veo API (metered; separate from Google Vids quota)
GEMINI_API_KEY=
GEMINI_VEO_MODEL=veo-3.1-generate-preview
# Keep these synchronized with current official pricing before enabling execution.
GEMINI_VEO_USD_PER_SECOND=
GEMINI_VEO_MAX_COST_USD=

# Runway Dev API + Model Router
RUNWAYML_API_SECRET=
# Legacy alias accepted by the adapter:
RUNWAY_API_KEY=
RUNWAY_ROUTER_CONFIG_ID=
RUNWAY_MAX_CREDITS_PER_GENERATION=

# Future paid gateways (routing registry only until execution adapters are verified)
EDENAI_API_KEY=
COMETAPI_API_KEY=

# Paid routes must remain opt-in at the request/user-policy layer.
VIDEO_ROUTER_PAID_FALLBACK=false
VIDEO_ROUTER_MAX_COST_USD=0

# External generation execution is OFF by default.
VIDEO_EXECUTION_ENABLED=false
VIDEO_EXECUTION_TOKEN=

# Separate operator approval boundary for metered providers.
# Approval tokens are short-lived and HMAC-signed with VIDEO_APPROVAL_SECRET.
VIDEO_APPROVAL_TOKEN=
VIDEO_APPROVAL_SECRET=

# Durable project/job state
MONGODB_URI=
REDIS_URL=

# Offline Kaggle notebook -> private R2 artifact bridge.
# Generate a unique random token (at least 32 characters) in your secret manager.
# Save the same value in Kaggle Add-ons > Secrets as AIVIDEO_BRIDGE_TOKEN.
# Never expose it via NEXT_PUBLIC_* or notebook source code.
KAGGLE_BRIDGE_TOKEN=

# Cloudflare R2 media storage
# The Next/OpenNext runtime uses the VIDEO_ASSETS R2 binding in wrangler.jsonc.
R2_BUCKET=mabrig-verse
# Optional S3 credentials retained for external tools/workers; not required by
# the in-Worker R2 binding path.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Default is 512 MiB per provider artifact when unset.
VIDEO_ARTIFACT_MAX_BYTES=536870912
# Comma-separated exact hosts or wildcard suffixes such as *.example-cdn.com.
# Provider defaults are intentionally narrow; add a current provider CDN host
# here when its signed output URLs use a different trusted hostname.
VIDEO_ARTIFACT_ALLOWED_HOSTS=

# GPU generation / lip-sync / FFmpeg worker
# MuseTalk uses the same authenticated worker. The executable receives engine=musetalk,
# audio_url, source_image_url/source_video_url and must return JSON {"outputUrls":[...]}.
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
# Public HTTPS origin of the self-hosted worker; required by the Wan worker so
# protected output URLs can be returned to AI Video for private R2 persistence.
GPU_WORKER_PUBLIC_URL=
# Worker-container variables:
VIDEO_GENERATION_EXECUTABLE=
VIDEO_GENERATION_TIMEOUT_SECONDS=900
VIDEO_OUTPUT_DIR=/data/outputs

# Optional self-hosted Wan Diffusers worker
WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_CPU_OFFLOAD=true
WAN_NUM_FRAMES=81
WAN_FPS=16
WAN_STEPS=30
WAN_GUIDANCE_SCALE=5.0
WAN_SEED=42

# Phase 2 distribution OAuth / APIs
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WEBSITE_PUBLISH_URL=
WEBSITE_PUBLISH_TOKEN=
