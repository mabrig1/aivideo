# Public app URL
NEXT_PUBLIC_APP_URL=https://aivideo.mabrigkorie.org

# Reasoning / agent providers
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=

# Universal video router
# Google Vids included quota is an account entitlement, not Gemini/Veo API credit.
# Keep disabled until an authorized connector/local bridge supplies the user's quota.
GOOGLE_VIDS_BRIDGE_ENABLED=false

# Gemini/Veo API (metered; separate from Google Vids quota)
GEMINI_API_KEY=
GEMINI_VEO_MODEL=veo-3.1-generate-preview
# Keep these synchronized with current official pricing before enabling execution.
GEMINI_VEO_USD_PER_SECOND=
GEMINI_VEO_MAX_COST_USD=

# Runway Dev API + Model Router
RUNWAYML_API_SECRET=
# Legacy alias accepted by the adapter:
RUNWAY_API_KEY=
RUNWAY_ROUTER_CONFIG_ID=
RUNWAY_MAX_CREDITS_PER_GENERATION=

# Future paid gateways (routing registry only until execution adapters are verified)
EDENAI_API_KEY=
COMETAPI_API_KEY=

# Paid routes must remain opt-in at the request/user-policy layer.
VIDEO_ROUTER_PAID_FALLBACK=false
VIDEO_ROUTER_MAX_COST_USD=0

# External generation execution is OFF by default.
VIDEO_EXECUTION_ENABLED=false
VIDEO_EXECUTION_TOKEN=

# Durable project/job state
MONGODB_URI=
REDIS_URL=

# Offline Kaggle notebook -> private R2 artifact bridge.
# Generate a unique random token (at least 32 characters) in your secret manager.
# Save the same value in Kaggle Add-ons > Secrets as AIVIDEO_BRIDGE_TOKEN.
# Never expose it via NEXT_PUBLIC_* or notebook source code.
KAGGLE_BRIDGE_TOKEN=

# Cloudflare R2 media storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mabrig-verse

# GPU generation / lip-sync / FFmpeg worker
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
# Worker-container variables:
VIDEO_GENERATION_EXECUTABLE=
VIDEO_GENERATION_TIMEOUT_SECONDS=900

# Phase 2 distribution OAuth / APIs
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
WEBSITE_PUBLISH_URL=
WEBSITE_PUBLISH_TOKEN=
