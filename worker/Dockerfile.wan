FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models/huggingface \
    VIDEO_OUTPUT_DIR=/data/outputs \
    WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg python3 python3-pip git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-wan.txt ./
RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cu124 torch torchvision \
    && pip3 install --no-cache-dir -r requirements-wan.txt

COPY wan_server.py .

RUN mkdir -p /data/outputs /models/huggingface

EXPOSE 8080

CMD ["uvicorn", "wan_server:app", "--host", "0.0.0.0", "--port", "8080"]
